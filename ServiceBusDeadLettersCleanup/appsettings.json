{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ServiceBusDeadLettersCleanup": "Information"
    }
  },
  "AllowedHosts": "*",

  // Configuration settings for the Azure Service Bus
  "ServiceBus": {
    // Connection string for the Azure Service Bus
    "ConnectionString": "",
    
    // Optional: Include only specific queues (null or omit to process all)
    // "IncludeQueues": ["queue1", "queue2"],
    
    // Optional: Include only specific topics (null or omit to process all)
    // "IncludeTopics": ["topic1", "topic2"],
    
    // Optional: Exclude specific queues
    // "ExcludeQueues": ["system-queue"],
    
    // Optional: Exclude specific topics
    // "ExcludeTopics": ["system-topic"],
    
    // Processor performance settings
    "PrefetchCount": 50,
    "MaxConcurrentCalls": 10
  },
  
  // Configuration settings for the Azure Storage Account
  "StorageAccount": {
    // Connection string for the Azure Storage Account
    "ConnectionString": "",
    // Name of the blob container to store dead-letter messages
    "ContainerName": "bus-dead-letters"
  }
}
